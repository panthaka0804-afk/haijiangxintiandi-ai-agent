[Unit]
Description=海江新天地 小江AI Flask 后端
After=network.target

[Service]
# 运行用户：按服务器实际情况调整（通常建一个专用低权限用户，如 www-data）
User=www-data
Group=www-data
WorkingDirectory=/opt/haijiang/dajudali
# 用 python3 直接跑 server.py（server.py 内部已绑定 0.0.0.0:8765）
ExecStart=/usr/bin/python3 /opt/haijiang/dajudali/server.py
Restart=always
RestartSec=5
# 密钥由 server.py 同目录 .env 自动加载（python-dotenv），无需在此填写，也不会进仓库
# 如需在此覆盖（优先级高于 .env），取消下行注释：
# Environment=DS_API_KEY=xxxx
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
