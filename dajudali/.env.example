# ============================================================
#  海江新天地 - 小江AI  环境变量模板
#  用法：复制本文件为同目录 .env，填入真实值。.env 切勿提交到 git。
# ============================================================

# ===== AI 模型 Key =====
# DeepSeek（AI 聊天主模型，必填）：https://platform.deepseek.com
DS_API_KEY=your_deepseek_api_key_here

# 备用：通义千问（阿里云），留空则回退到 DS_API_KEY
QWEN_API_KEY=

# ===== 安全 =====
# 若服务器缺少 CA 证书导致 DeepSeek 调用 SSL 失败，临时设 1（不推荐长期使用，应修复证书）
DJDL_INSECURE_SSL=0

# ===== 运行参数 =====
# Flask 监听端口（nginx/systemd 部署需与 nginx 反代端口一致）
FLASK_PORT=8765

# SQLite 数据库路径（默认项目内 dajudali.db；服务器部署建议改到持久目录）
# DB_PATH=/opt/haijiang/dajudali/dajudali.db
